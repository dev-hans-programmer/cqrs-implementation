ORDER_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003
DOWNSTREAM_TIMEOUT_SECONDS=5
DOWNSTREAM_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.1
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=15

# Keep `memory` for unit-test/local mode. Docker Compose overrides these values.
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql://app:app@localhost:5432/service_db
RABBITMQ_URL=amqp://app:app@localhost:5672/

RATE_LIMIT_ENABLED=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SECOND=20

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

